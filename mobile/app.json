{
  "expo": {
    "name": "GodwitCareGlobal",
    "slug": "godwitcare",
    "owner": "shekharchauhan",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/app_icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash_icon_teal.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C6E7E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.godwitcare.mobile",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "GodwitCareGlobal uses your camera to take a profile photo and to photograph travel documents (passport, ID) for your consultation.",
        "NSPhotoLibraryUsageDescription": "GodwitCareGlobal accesses your photo library so you can choose a profile photo or upload travel documents from your gallery.",
        "NSFaceIDUsageDescription": "GodwitCareGlobal uses Face ID to let you quickly and securely unlock the app instead of entering your PIN.",
        "NSLocationWhenInUseUsageDescription": "GodwitCareGlobal may use your location to help pre-fill your travel details."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.godwitcare.mobile",
      "versionCode": 6,
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "MANAGE_EXTERNAL_STORAGE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.DOWNLOAD_WITHOUT_NOTIFICATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "godwitcare"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "@config-plugins/react-native-blob-util",
      "expo-location",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.godwitcare.app",
          "enableGooglePay": false
        }
      ]
    ],
    "scheme": "godwitcare",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1e79f731-a71d-40a6-88fc-09f8f15e3908"
      }
    }
  }
}
